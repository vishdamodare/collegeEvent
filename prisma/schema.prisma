datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  ORGANIZER
  SUPER_ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  CANCELLED
  CHECKED_IN
  COMPLETED
  CERTIFICATE_ISSUED
}

// ─── Auth Models (Better Auth compatible) ───────────────────────────────────

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Custom Application Fields
  role         UserRole @default(STUDENT)
  passwordHash String?
  provider     String?
  providerId   String?

  sessions         Session[]
  accounts         Account[]
  studentProfile   StudentProfile?
  organizerProfile OrganizerProfile?
  notifications    Notification[]

  // Events created by this user (when role = ORGANIZER or SUPER_ADMIN)
  events Event[]
  savedEvents SavedEvent[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  password              String?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([value])
}

// ─── Profile Models ─────────────────────────────────────────────────────────

model StudentProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college            String
  branch             String
  academicYear       String
  interests          String[]
  bio                String?
  phoneNumber        String?
  gender             String?
  studentId          String?
  phoneVerified      Boolean  @default(false)
  verifiedAt         DateTime?
  verificationMethod String?
  profileImage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Registrations relation
  registrations Registration[]
  tickets       Ticket[]

  @@index([userId])
}

model OrganizerProfile {
  id                   String    @id @default(uuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  college              String
  department           String
  position             String
  description          String?
  website              String?
  instagram            String?
  linkedin             String?
  address              String?
  verificationStatus   String    @default("PENDING") // PENDING | APPROVED | REJECTED | BLOCKED
  verificationDocument String?
  approvedBy           String?
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
  @@index([verificationStatus])
}

// ─── Core Domain Models ─────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  icon        String?  // Emoji or icon identifier
  description String?
  color       String?
  isArchived  Boolean  @default(false)
  events      Event[]
}

model Event {
  id                  String      @id @default(uuid())
  title               String
  slug                String      @unique
  description         String      @db.Text
  date                DateTime
  location            String
  capacity            Int
  isClosed            Boolean     @default(false)
  status              EventStatus @default(DRAFT)
  eventType           String      @default("INDIVIDUAL") // INDIVIDUAL | TEAM
  teamMinSize         Int         @default(1)
  teamMaxSize         Int         @default(1)
  additionalQuestions Json?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Event owner (organizer or super_admin User)
  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images        EventImage[]
  registrations Registration[]
  tickets       Ticket[]
  savedBy       SavedEvent[]

  @@index([date])
  @@index([status])
  @@index([categoryId])
  @@index([organizerId])
}

model EventImage {
  id        String   @id @default(uuid())
  eventId   String
  url       String
  isHero    Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Registration {
  id                  String             @id @default(uuid())
  eventId             String
  studentId           String
  status              RegistrationStatus @default(PENDING)
  checkedIn           Boolean            @default(false)
  checkedInAt         DateTime?
  checkedInBy         String?
  checkInDevice       String?
  checkInMethod       String?            // QR | MANUAL
  checkInStatus       String             @default("NOT_CHECKED_IN") // NOT_CHECKED_IN | CHECKED_IN
  phoneVerified       Boolean            @default(false)
  registrationAnswers Json?
  teamName            String?
  registrationType    String             @default("INDIVIDUAL")
  timeline            Json?
  registeredAt        DateTime           @default(now())
  cancelledAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ticket       Ticket?
  teamMembers  TeamMember[]

  @@unique([eventId, studentId]) // Prevents double-registration
  @@index([eventId])
  @@index([studentId])
}

model Ticket {
  id                String         @id @default(uuid())
  registrationId    String         @unique
  eventId           String
  studentId         String
  ticketNumber      String         @unique
  verificationToken String         @unique
  qrCode            String?        @db.Text
  status            String         @default("ACTIVE") // ACTIVE | USED | CANCELLED | EXPIRED
  issuedAt          DateTime       @default(now())
  downloadUrl       String?
  downloadCount     Int            @default(0)
  shareCount        Int            @default(0)
  lastDownloadedAt  DateTime?
  lastSharedAt      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  registration Registration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([studentId])
}

model TeamMember {
  id             String       @id @default(uuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  name           String
  email          String
  phone          String
  otpVerified    Boolean      @default(false)
  college        String
  branch         String
  academicYear   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([registrationId])
}

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model SavedEvent {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
